# Optional. Copy to .env; never commit credentials.
# Without DATABASE_URL, npm start creates an empty local SQLite database.
# Supabase: Transaction pooler for Vercel; Session pooler for persistent Node.
# Paste the full postgresql:// URI with the database password filled in.
DATABASE_URL=
# Optional project CA certificate path, if your provider requires it.
DATABASE_CA_FILE=
# Vercel alternative: provider CA certificate, full PEM text.
DATABASE_CA_CERT=
PUBLIC_ORIGIN=http://localhost:3000
# Public website with shared missions/history. No visitor login.
APP_ACCESS=public
# Optional private deployment only: APP_ACCESS=private and set both below.
BASIC_AUTH_USER=crew
BASIC_AUTH_PASSWORD=
# Deployment only: HOST=0.0.0.0 (PORT comes from the host).
# MARSWALK_DB=data/marswalk-v2.sqlite
